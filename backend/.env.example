# Configuración de Base de Datos
# Por defecto utiliza SQLite en proyecto.db para facilitar la ejecución local al clonar.
# Para MariaDB/MySQL, comentar DATABASE_URL y configurar DB_*:
# DB_USUARIO=root
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PUERTO=3306
# DB_NOMBRE=proyecto

DATABASE_URL=sqlite:///./proyecto.db

